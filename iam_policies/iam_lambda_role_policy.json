{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCuratedZoneOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::intrusion-detection-curated/*"
    },
    {
      "Sid": "ReadModelArtifactOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::intrusion-detection-models/isolation_forest_model.pkl"
    },
    {
      "Sid": "PublishAlertsOnly",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:*:*:security-alerts"
    },
    {
      "Sid": "LambdaLogging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/intrusion-scoring-fn:*"
    }
  ]
}
