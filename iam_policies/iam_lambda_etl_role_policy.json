{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawZoneOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::intrusion-detection-raw-*/*"
    },
    {
      "Sid": "ReadModelArtifactsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::intrusion-detection-models-*/label_encoders.pkl",
        "arn:aws:s3:::intrusion-detection-models-*/feature_columns.pkl"
      ]
    },
    {
      "Sid": "WriteCuratedZoneOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::intrusion-detection-curated-*/*"
    },
    {
      "Sid": "LambdaLogging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/intrusion-etl-fn:*"
    }
  ]
}
