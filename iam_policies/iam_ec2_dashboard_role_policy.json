{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadResultsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::intrusion-detection-curated",
        "arn:aws:s3:::intrusion-detection-curated/*"
      ]
    },
    {
      "Sid": "ReadCloudWatchMetricsOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    }
  ]
}
